formulas:
  link-title: file.aslink(title)
properties:
  formula.link-title:
    displayName: Link
  note.group-min:
    displayName: Spieler Min
  note.group-max:
    displayName: Spieler Max
  note.Schwierigkeit:
    displayName: Schwierigkeit
  note.Material:
    displayName: Material
  note.Spieldauer:
    displayName: Spieldauer
views:
  - type: table
    name: Aufwärmspiele MOC
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("warm-up")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    sort:
      - property: Schwierigkeit
        direction: ASC
      - property: group-max
        direction: ASC
    columnSize:
      formula.link-title: 238
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Bewegungsspiele
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("bewegung")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Cooldown Spiele MOC
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("cool-down")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Fangspiele
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("fangen")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: index
    filters:
      and:
        - lang == "de"
    groupBy:
      property: update
      direction: DESC
    order:
      - file.name
      - authors
      - tags
      - update
    sort:
      - property: update
        direction: DESC
    limit: 10
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: list
    name: Kaskade Magazin
    filters:
      and:
        - lang == "de"
        - file.hasTag("kaskade")
        - type.contains("magazin")
    order:
      - file.name
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Kaskade Artikel
    filters:
      and:
        - lang == "de"
        - file.hasTag("kaskade")
        - '!type.containsAny("magazin")'
    order:
      - formula.link-title
      - authors
      - type
      - sub-type
      - source
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Klatschspiele MOC
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("klatschspiel")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Kooperationsspiele
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("Kooperation")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      file.name: 292
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Kreisspiele MOC
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("kreisspiel")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Beigoma
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("beigoma")
        - '!file.hasTag("moc")'
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Liste aller Spiele
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - '!file.hasTag("moc")'
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Call and Response
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("call-response")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Schnelligkeit+Reaktionsspiele
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("action")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Spiele für Zwischendurch
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("sonstiges")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Spiele zum Kennenlernen
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("kennenlernen")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Taktik und Konzentrationsspiele
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("Taktik")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Inklusion-Spiele
    filters:
      and:
        - lang == "de"
        - file.hasTag("spiele")
        - category.contains("inklusion")
    order:
      - formula.link-title
      - group-min
      - group-max
      - Schwierigkeit
      - Material
      - Spieldauer
    columnSize:
      note.group-min: 116
      note.group-max: 121
  - type: table
    name: Convention-Games
    filters:
      and:
        - lang == "de"
        - category.contains("convention-games")
    order:
      - formula.link-title
      - category
      - group-max
      - group-min
      - Schwierigkeit
      - Material
      - Spieldauer
